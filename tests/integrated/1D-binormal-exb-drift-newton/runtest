#!/usr/bin/env python3

# Binormal ExB drift in a 1D island divertor SOL with neutrals and recycling at
# R = 0.97 and v_E from the sheath potential (vE_mode = sheath), solved with the
# Newton (backward Euler, PETSc SNES) solver. CVODE with the band-block-diagonal
# preconditioner stalls in this case.
#
# Checks that
#   - the solver reaches a steady state
#   - the total velocity v_par + v_E/Theta is sonic at both targets
#   - particles are conserved (target flux = core + ionisation - recombination,
#     recycled = R * target flux, core = (1 - R) * target flux)
#   - energy is conserved (sheath + radiation + kinetic energy of source
#     particles = power input + ExB work + energy of the recycled atoms)
#   - v_E = mean target sheath potential / (B lambda)
#   - the drift is weaker than at R = 0.9 (where lambda gives v_E = 66 m/s),
#     and still makes the upper target denser
#   - restarted on 2 processors (block Jacobi with LU blocks), the solver stays
#     at the same steady state

import shutil
import sys
from pathlib import Path

import numpy as np
from boutdata import restart
from boutdata.collect import collect
from boututils.run_wrapper import launch_safe

R = 0.97  # d+:target_recycle_multiplier in data/BOUT.inp
B = 2.5  # [T] (Bnorm)
lam = 1.439  # binormal_exb_drift:potential_decay_length [m]
vE_R09 = 66.0  # v_E with this lambda at R = 0.9 [m/s]

QE = 1.602176634e-19
MP = 1.67262192595e-27
AA = 2.0

steady_tolerance = 1e-8
bohm_tolerance = 0.15
particle_tolerance = 1e-3
# Discretisation error at the steep target gradients, ~5% in near-symmetric
# cases at high recycling
energy_tolerance = 0.08
mpi_tolerance = 1e-6

hermes_candidates = [Path("../../../hermes-3"), Path("../../../build/hermes-3")]
hermes_exec = next((path for path in hermes_candidates if path.exists()), None)
if hermes_exec is None:
    raise FileNotFoundError("Could not find hermes-3 executable in repo root or build/")

run_root = Path("runs")
input_text = Path("data/BOUT.inp").read_text()


def prepare(name, text):
    case_dir = run_root / name
    if case_dir.exists():
        shutil.rmtree(case_dir)
    case_dir.mkdir(parents=True)
    (case_dir / "BOUT.inp").write_text(text)
    return case_dir


def launch(case_dir, args="", nproc=1):
    print(f"Running {case_dir} {args} on {nproc} processor(s)")
    status, out = launch_safe(
        f"{hermes_exec} -d {case_dir} {args}", nproc=nproc, pipe=True
    )
    (case_dir / "run.log").write_text(out)
    if status != 0:
        raise RuntimeError(f"Hermes run failed for {case_dir}")


def get(case_dir, var):
    """Variable in SI units (applies the conversion attribute)"""
    data = collect(var, path=str(case_dir), info=False)
    conversion = float(data.attributes.get("conversion", 1.0))
    return np.asarray(data).squeeze() * conversion


failures = []


def check(name, value, ok):
    print(f"    {name}: {value} -> {'Passed' if ok else 'Failed'}")
    if not ok:
        failures.append(name)


case = prepare("newton", input_text)
launch(case)

d = {}
for key in ["Nd+", "Pd+", "Pe", "Nd", "Pd", "Td+", "Te", "Vd+"]:
    values = get(case, key)
    d[key] = values[-1]
    d[key + "_prev"] = values[-2]
for key in [
    "Sd+_src",
    "Pd+_src",
    "Pe_src",
    "Sd+_sheath",
    "Ed+_sheath",
    "Ee_sheath",
    "Sd+_iz",
    "Sd+_rec",
    "Sd_target_recycle",
    "Ed_target_recycle",
    "Rd+_ex",
    "Rd+_rec",
]:
    values = get(case, key)
    d[key] = values[-1] if values.ndim > 1 else values
W = get(case, "w_binormal_exb_drift")
W = W[-1] if W.ndim > 1 else W
rho_s0 = float(collect("rho_s0", path=str(case), info=False))
dy = np.asarray(collect("dy", path=str(case), info=False)).squeeze()
g_22 = np.asarray(collect("g_22", path=str(case), info=False)).squeeze()
ds = dy * np.sqrt(g_22) * rho_s0  # Parallel cell length [m] (J = 1)

print("  Steady state with the Newton solver")
change = max(
    np.max(np.abs(d[k] - d[k + "_prev"]) / np.abs(d[k]))
    for k in ["Nd+", "Pd+", "Pe", "Nd", "Pd"]
)
check("steady state (relative change in the last output)", f"{change:.1e}",
      change < steady_tolerance)

N, Ti, Te, V = d["Nd+"], d["Td+"], d["Te"], d["Vd+"]
mi = AA * MP
cs = np.sqrt((Ti + Te) * QE / mi)
u_lower = (V[0] + W[0]) / cs[0]
u_upper = (V[-1] + W[-1]) / cs[-1]
check(
    "Bohm condition on v_par + v_E/Theta",
    f"lower {u_lower:.3f}, upper {u_upper:.3f}",
    abs(u_lower + 1) < bohm_tolerance and abs(u_upper - 1) < bohm_tolerance,
)

flux_lower = abs(d["Sd+_sheath"][0]) * ds[0]
flux_upper = abs(d["Sd+_sheath"][-1]) * ds[-1]
flux = flux_lower + flux_upper
core = np.sum(d["Sd+_src"] * ds)
ionisation = np.sum(d["Sd+_iz"] * ds)
recombination = -np.sum(d["Sd+_rec"] * ds)
recycled = np.sum(d["Sd_target_recycle"] * ds)
for name, ratio in [
    ("target flux / (core + ionisation - recombination)",
     flux / (core + ionisation - recombination)),
    ("recycled / (R * target flux)", recycled / (R * flux)),
    ("(1 - R) * target flux / core source", (1 - R) * flux / core),
]:
    check(name, f"{ratio:.5f}", abs(ratio - 1) < particle_tolerance)

power_in = np.sum(1.5 * (d["Pd+_src"] + d["Pe_src"]) * ds)
sheath = -np.sum((d["Ed+_sheath"] + d["Ee_sheath"]) * ds)
radiation = -np.sum((d["Rd+_ex"] + d["Rd+_rec"]) * ds)
recycle_energy = np.sum(d["Ed_target_recycle"] * ds)
p_total = N * (Te + Ti) * QE
work_exb = np.mean(W) * (p_total[-1] - p_total[0])
dilution = np.sum(0.5 * mi * V**2 * d["Sd+_src"] * ds)
balance = (sheath + radiation + dilution) / (power_in + work_exb + recycle_energy)
check("energy balance", f"{balance:.4f}", abs(balance - 1) < energy_tolerance)

print("  v_E from the sheath potential")
phi_lower = get(case, "phi_sheath_lower_binormal_exb_drift")
phi_upper = get(case, "phi_sheath_upper_binormal_exb_drift")
vE = get(case, "vE_binormal_exb_drift")
phi_lower, phi_upper, vE = (np.ravel(a)[-1] for a in (phi_lower, phi_upper, vE))
check(
    "v_E = mean phi / (B lambda)",
    f"{vE:.4f} m/s (phi {phi_lower:.1f}, {phi_upper:.1f} V)",
    abs(vE / (0.5 * (phi_lower + phi_upper) / (B * lam)) - 1) < 1e-10,
)
ratio = N[-1] / N[0]
check(
    "weaker drift than at R = 0.9, upper target denser",
    f"v_E {vE:.2f} m/s (66 at R = 0.9), n_upper/n_lower {ratio:.3f}, "
    f"target fluxes {flux_lower:.3e}, {flux_upper:.3e} m^-2 s^-1",
    vE < 0.5 * vE_R09 and ratio > 1.0 and flux_upper > flux_lower,
)

print("  Restart on 2 processors")
text2 = input_text.replace("pc_type = lu ", "pc_type = bjacobi ") + (
    "\n[petsc]\nsub_pc_type = lu   # LU on each processor's block\n"
)
assert "pc_type = bjacobi" in text2
case2 = prepare("newton_np2", text2)
restart.redistribute(2, path=str(case), output=str(case2), myg=2, mxg=0)
launch(case2, "restart nout=2", nproc=2)
difference = max(
    np.max(np.abs(get(case2, k)[-1] - d[k])) / np.max(np.abs(d[k]))
    for k in ["Nd+", "Pd+", "Pe", "Nd", "Pd"]
)
check("same steady state on 2 processors", f"{difference:.1e}",
      difference < mpi_tolerance)

if failures:
    print(f"\n => Failed: {', '.join(failures)}")
    sys.exit(1)

print("\n => All passed")
sys.exit(0)
